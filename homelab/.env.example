# Copy to .env and fill in before running docker compose up.

# Public hostname NPM will proxy to this stack, e.g. dash.snvgglebear.com
DASHBOARD_DOMAIN=dash.snvgglebear.com

# Root domain, used for Authelia session cookie scope
ROOT_DOMAIN=snvgglebear.com

TZ=America/New_York

# ProtonVPN WireGuard private key for gluetun (VPN Config -> WireGuard in the
# ProtonVPN dashboard). Never commit the real value.
WIREGUARD_PRIVATE_KEY=REPLACE_ME_WIREGUARD_PRIVATE_KEY
